@model IEnumerable<Portfolio.Web.Models.Admin.ExperienceViewModel>

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h2 class="text-2xl font-bold">Experiences</h2>
            <p class="text-sm opacity-60">Manage your employment history, roles, and career timeline.</p>
        </div>
        <button class="btn btn-primary gap-2" 
                hx-get="@Url.Action("Create", "Experiences")" 
                hx-target="#modal-body"
                onclick="admin_modal.showModal()">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Add Experience
        </button>
    </div>

    <div class="overflow-x-auto border border-base-300 rounded-box bg-base-100">
        <table class="table table-md w-full">
            <thead>
                <tr class="bg-base-200">
                    <th>Role & Company</th>
                    <th>Location</th>
                    <th>Duration</th>
                    <th>Description</th>
                    <th>Skills Used</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody id="experience-list">
                @if (!Model.Any())
                {
                    <tr id="no-experiences-row">
                        <td colspan="6" class="text-center py-10 opacity-60">
                            <div class="flex flex-col items-center justify-center space-y-2">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" class="w-12 h-12 text-base-content/40">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M22.5 21L1.5 21m2.25-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3.75-6h.75m-.75 3h.75m-.75 3h.75m9-3h.75m-.75 3h.75m-.75 3h.75" />
                                </svg>
                                <span class="font-semibold text-lg">No experience logs yet</span>
                                <span class="text-sm">Click "+ Add Experience" to insert your first career milestone.</span>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var experience in Model)
                    {
                        <partial name="Experiences/_ExperienceRow" model="experience" />
                    }
                }
            </tbody>
        </table>
    </div>
</div>
