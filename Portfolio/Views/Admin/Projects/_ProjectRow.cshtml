@model Portfolio.Web.Models.Admin.ProjectViewModel

<tr id="project-@Model.Id" class="hover align-top transition-all duration-200">
    <td class="whitespace-nowrap">
        <div class="font-bold text-base text-neutral-content">@Model.Name</div>
        @if (!string.IsNullOrEmpty(Model.GitHubLink))
        {
            <a href="@Model.GitHubLink" target="_blank" rel="noopener noreferrer" class="link link-primary link-hover text-xs inline-flex items-center gap-1 mt-1 font-mono">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
                </svg>
                GitHub Link
            </a>
        }
    </td>
    <td class="max-w-xs md:max-w-md whitespace-normal break-words text-sm opacity-90">
        @Model.Description
    </td>
    <td>
        <div class="flex flex-wrap gap-1 max-w-xs">
            @if (Model.Skills != null && Model.Skills.Any())
            {
                @foreach (var skill in Model.Skills)
                {
                    <span class="badge badge-sm badge-outline">@skill.Name</span>
                }
            }
            else
            {
                <span class="text-xs opacity-40 italic">No skills linked</span>
            }
        </div>
    </td>
    <td>
        <div class="flex justify-end gap-1">
            <button class="btn btn-ghost btn-xs text-primary gap-1"
                    hx-get="@Url.Action("Edit", "Projects", new { id = Model.Id })"
                    hx-target="#modal-body"
                    onclick="admin_modal.showModal()">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.83 20.013a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                </svg>
                Edit
            </button>
            <button class="btn btn-ghost btn-xs text-error gap-1"
                    hx-delete="@Url.Action("Delete", "Projects", new { id = Model.Id })"
                    hx-confirm="Are you sure you want to delete the project '@Model.Name'?"
                    hx-target="#project-@Model.Id"
                    hx-swap="delete">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                </svg>
                Delete
            </button>
        </div>
    </td>
</tr>
